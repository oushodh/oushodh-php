{
    "name": "oushodh/oushodh-php",
    "description": "PHP SDK for the Oushodh medicine data API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "oushodh",
        "medicine",
        "api",
        "sdk",
        "bangladesh"
    ],
    "homepage": "https://oushodh.dev/docs",
    "authors": [
        {
            "name": "Oushodh",
            "email": "support@oushodh.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Oushodh\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oushodh\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "lint": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "support": {
        "docs": "https://oushodh.dev/docs",
        "email": "support@oushodh.dev",
        "issues": "https://github.com/oushodh/oushodh-php/issues",
        "source": "https://github.com/oushodh/oushodh-php"
    }
}
